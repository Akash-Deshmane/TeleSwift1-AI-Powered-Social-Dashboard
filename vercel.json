{
  "buildCommand": "cd front_end_web && npm install && npm run build",
  "outputDirectory": "front_end_web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/teleswift/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
